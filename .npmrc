# Electron binary download mirror (GitHub releases are slow/unreachable from CN networks).
# Feeds @electron/get via npm_config_electron_mirror during electron's postinstall.
electron_mirror=https://registry.npmmirror.com/-/binary/electron/
# Mirror for electron-builder helper binaries (winCodeSign, nsis, etc.) used by pnpm build.
electron_builder_binaries_mirror=https://registry.npmmirror.com/-/binary/electron-builder-binaries/
