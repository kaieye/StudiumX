# StudiumX-Server base URL for the Web app.
#
# The Web app is a thin client for ONE StudiumX-Server: this value is used for
# login (web/src/auth), the HTTP adapter (web/src/api), and (via the bootstrap
# in web/src/main.tsx) the shared renderer's sync-store, which drives study-room
# presence. All three must point at the same server.
#
# To sync the Web study room with the desktop client, set this to the SAME
# server the desktop uses for sync. The desktop sync default is
# https://api.studiumx.cn; the local dev server runs on http://localhost:3000.
#
# Local dev default (var unset): http://localhost:3000
VITE_API_BASE_URL=https://api.studiumx.cn
