    "check:context-compactor": "node scripts/check-context-compactor.mjs",
    "check:agent-tool-registry": "node scripts/check-agent-tool-registry.mjs",
    "check:agent-capability-policy": "node scripts/check-agent-capability-policy.mjs",
    "check:agent-external-content-boundary": "node scripts/check-agent-external-content-boundary.mjs",
    "check:agent-loop-baseline": "node scripts/check-agent-loop-baseline.mjs",
    "check:agent-run-budget": "node scripts/check-agent-run-budget.mjs",
    "check:agent-loop-context-hygiene": "node scripts/check-agent-loop-context-hygiene.mjs",
    "check:agent-loop-context-compaction": "node scripts/check-agent-loop-context-compaction.mjs",
    "check:agent-delegation-runtime": "node scripts/check-agent-delegation-runtime.mjs",
    "check:agent-loop-empty-final": "node scripts/check-agent-loop-empty-final.mjs",
    "check:tool-execution": "node scripts/check-tool-execution.mjs",
    "check:tool-permissions": "node scripts/check-tool-permissions.mjs",
    "check:scoped-tool-permissions": "node scripts/check-scoped-tool-permissions.mjs",
    "check:workspace-write-tool": "node scripts/check-workspace-write-tool.mjs",
    "check:dsml-tool-calls": "node scripts/check-dsml-tool-calls.mjs",
    "check:teaching-mode": "node scripts/check-overview-teaching-mode.mjs",
    "check:concept-overview": "node scripts/check-concept-overview-lesson.mjs",
    "check:lesson-generation-flow": "node scripts/check-lesson-generation-flow.mjs",
    "check:lesson-record-cutover": "node scripts/check-lesson-record-cutover.mjs",
    "check:lesson-styles": "node scripts/check-lesson-styles.mjs",
    "check:skill-library": "node scripts/check-skill-library.mjs",
    "check:resource-dark-theme": "node scripts/check-resource-dark-theme.mjs",
    "check:pet-library": "node scripts/check-pet-library.mjs",
    "check:pet-notifications": "node scripts/check-pet-notifications.mjs",
    "check:pet-animation": "pnpm run build && node scripts/check-pet-animation.mjs",
    "check:lesson-markdown": "node scripts/check-lesson-markdown-rendering.mjs",
    "check:markdown-preview": "node scripts/check-markdown-preview-capabilities.mjs",
    "check:dark-theme-neutrality": "node scripts/check-dark-theme-neutrality.mjs",
    "check:provider-errors": "node scripts/check-provider-errors.mjs",
    "check:provider-format-adapters": "node scripts/check-provider-format-adapters.mjs",
    "check:model-provider-catalog": "node scripts/check-model-provider-catalog.mjs",
    "check:model-settings-custom-provider": "node scripts/check-model-settings-custom-provider.mjs",
    "check:provider-actions": "node scripts/check-provider-actions.mjs",
    "check:dialog-ime": "node scripts/check-dialog-ime-composition.mjs",
    "check:sidebar-ui": "node scripts/check-sidebar-ui.mjs",
    "check:window-chrome-clickability": "node scripts/check-window-chrome-clickability.mjs",
    "check:study-session-transitions": "node scripts/check-study-session-transitions.mjs",
    "check:workbench-leaderboard": "node scripts/check-workbench-leaderboard.mjs",
    "check:workbench-presence": "node scripts/check-workbench-presence.mjs",
    "check:workbench-card-separation": "node scripts/check-workbench-card-separation.mjs",
    "check:workbench-card-legibility": "node scripts/check-workbench-card-legibility.mjs",
    "check:workspace-import-course": "node scripts/check-workspace-import-course.mjs",
    "check:workspace-markdown": "node scripts/check-workspace-markdown-documents.mjs",
    "check:workspace-removal": "node scripts/check-workspace-removal-state.mjs",
    "check:search-runtime": "node scripts/check-search-runtime.mjs",
    "check:web-tools-baseline": "node scripts/check-web-tools-baseline.mjs",
    "check:connector-statuses": "node scripts/check-connector-statuses.mjs",
    "check:teaching-git-guards": "node scripts/check-teaching-git-guards.mjs",
    "check:workspace-changes": "node scripts/check-workspace-changes.mjs",
    "check:workspace-change-history": "node scripts/check-workspace-change-history.mjs",
    "check:web-search-providers": "node scripts/check-web-search-providers.mjs",
    "check:web-fetch-safe-url": "node scripts/check-web-fetch-safe-url.mjs",
    "check:external-link-controls": "node scripts/check-external-link-controls.mjs",
    "check:memory-capture": "node scripts/check-memory-capture.mjs",
    "check:teaching-personalization": "node scripts/check-teaching-personalization.mjs",
    "check:teaching-learning-loop": "node scripts/check-teaching-learning-loop.mjs",
    "check:teaching-app-commit-cutover": "node scripts/check-teaching-app-commit-cutover.mjs",
    "check:conversation-lesson-tool": "node scripts/check-conversation-lesson-tool.mjs",
    "check:workflow": "node scripts/check-teaching-workflow.mjs",
    "preview": "electron-vite preview",
    "dist": "pnpm run build && electron-builder",
    "check:repository-hygiene": "node scripts/check-repository-hygiene.mjs",
    "check:security": "node scripts/check-security.mjs",
    "check:provider-privacy": "node scripts/check-provider-privacy.mjs",
    "check:settings-secret-storage": "node scripts/check-settings-secret-storage.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests/setup/tsconfig.json",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration --passWithNoTests",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "pnpm run build && playwright test --project electron-e2e",
    "test:visual": "pnpm run build && playwright test --project electron-visual --pass-with-no-tests",
    "test:a11y": "pnpm run build && playwright test --project electron-e2e --grep @a11y --pass-with-no-tests",
    "check:analytics": "node scripts/check-study-analytics-test-foundation.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.0",
    "@codemirror/view": "^6.43.5",
    "@lezer/highlight": "^1.2.3",
    "i18next": "^26.3.3",
    "katex": "^0.17.0",
    "lucide-react": "^1.21.0",
    "markdown-it": "^14.3.0",
    "markdown-it-mark": "^4.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "mermaid": "^11.16.0",
    "parse5": "^8.0.1",
    "proxy-agent": "^6.5.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-i18next": "^17.0.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^3.25.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "1.61.1",
    "@tailwindcss/vite": "^4.3.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^26.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "electron": "^42.5.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "esbuild": "0.25.12",
    "jsdom": "^29.1.1",
    "playwright": "1.61.1",
    "typescript": "^6.0.3",
    "vite": "7.3.6",
    "vitest": "^4.1.10"
  },
  "build": {
    "appId": "com.local.studiumx",
    "productName": "StudiumX",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/builtin-skills",
        "to": "builtin-skills"
      }
    ]
  },
  "packageManager": "pnpm@11.9.0"
}
