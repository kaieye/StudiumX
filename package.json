    "check:teaching-evidence": "pnpm run check:learning-session-ledger && pnpm run check:lesson-interaction-recorder && pnpm run check:evidence-idempotency && pnpm run check:teaching-evidence-events",
    "check:course-conversations": "node scripts/check-course-conversations.mjs",
    "check:teaching-placement": "node scripts/check-teaching-placement.mjs",
    "check:message-history-keyboard": "node scripts/check-message-history-keyboard.mjs",
    "check:agent-event-bus": "node scripts/check-agent-event-bus.mjs",
    "check:agent-run-recovery": "node scripts/check-agent-run-recovery.mjs",
    "check:agent-parent-turn-staging": "node scripts/check-agent-parent-turn-staging.mjs",
    "check:agent-operation-idempotency": "node scripts/check-agent-operation-idempotency.mjs",
    "check:agent-process-timeline": "node scripts/check-agent-process-timeline.mjs",
