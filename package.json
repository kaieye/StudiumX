{
  "name": "studiumx",
  "version": "0.1.0",
  "description": "Personal AI teaching workspace built with Electron, React, TypeScript, Vite, and Tailwind CSS.",
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "tsc --noEmit && electron-vite build",
    "doctor": "node scripts/doctor.mjs",
    "check:doctor": "node scripts/check-doctor.mjs",
    "check:learning-work-reconcile": "node scripts/check-learning-work-reconcile.mjs",
    "check:path-access": "node scripts/check-path-access.mjs",
    "check:agent-conversation-catalog": "node scripts/check-agent-conversation-catalog.mjs",
    "check:agent-conversation-state": "node scripts/check-agent-conversation-state.mjs",
    "check:agent-conversation-audit-metadata": "node scripts/check-agent-conversation-audit-metadata.mjs",
    "check:agent-chat": "node scripts/check-agent-chat-model-routing.mjs",
    "check:agent-chat-cancel": "node scripts/check-agent-chat-cancel.mjs",
      "check:application-runtime": "node scripts/check-application-runtime.mjs",
    "check:app-shell-context-transitions": "node scripts/check-app-shell-context-transitions.mjs",
    "check:teaching-ipc-contract": "node scripts/check-teaching-ipc-contract.mjs",
