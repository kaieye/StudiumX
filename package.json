  "build": {
    "appId": "com.local.studiumx",
    "productName": "StudiumX",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/builtin-skills",
        "to": "builtin-skills"
      },
      {
        "from": "resources/sandbox",
        "to": "sandbox"
      },
      {
        "from": "build/trayTemplate.png",
        "to": "trayTemplate.png"
      },
      {
        "from": "build/trayTemplate@2x.png",
        "to": "trayTemplate@2x.png"
      },
      {
        "from": "build/trayIcon.png",
        "to": "trayIcon.png"
      },
      {
        "from": "build/trayIcon@2x.png",
        "to": "trayIcon@2x.png"
      },
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      }
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**",
      "node_modules/bindings/**",
      "node_modules/file-uri-to-path/**"
    ],
    "npmRebuild": false,
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.icns"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "kaieye",
        "repo": "StudiumX"
      }
    ]
  },
  "engines": {
    "node": ">=22 <25"
  },
  "packageManager": "pnpm@11.9.0",
  "author": "StudiumX",
  "license": "AGPL-3.0"
}
